#!/bin/sh
set -e

# Always execute from repository root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

echo "🚀 [Pre-Commit] Running Skyhook Tunnel pre-flight validation..."

# 1. Verify version synchronization across all components
echo "🏷️  [1/5] Verifying version synchronization..."
node scripts/verify-versions.js

# 2. Check Node CLI syntax
echo "📦 [2/5] Checking Node CLI syntax..."
node -c cli/bin/skyhook.js
node -c cli/src/client.js
node -c cli/test/ws_tunnel.test.js

# 3. Run Node CLI test suite
echo "🧪 [3/5] Running Node CLI test suite..."
node --test cli/test/*.test.js

# 4. Run Go server test suite
echo "🐹 [4/5] Running Go server tests..."
(cd server && go test -count=1 ./...)

# 5. Verify Go server compilation
echo "🔨 [5/5] Verifying Go server compilation..."
(cd server && go build -o /dev/null .)

echo "✅ [Pre-Commit] All tests and build checks passed! Proceeding with commit."
